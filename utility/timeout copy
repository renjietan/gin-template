package utility

import (
	"fmt"
	"sync"
	"time"
)

type TimeoutManager struct {
	timers map[string]*time.Timer
	mu     sync.Mutex
}

func NewTimeoutManager() *TimeoutManager {
	return &TimeoutManager{
		timers: make(map[string]*time.Timer),
	}
}

func (t *TimeoutManager) Set(name string, duration time.Duration, log_str string, fn func()) {
	t.mu.Lock()
	if t.timers == nil {
		t.timers = make(map[string]*time.Timer)
	}
	t.mu.Unlock()
	if _, exists := t.timers[name]; exists {
		t.StopByName(name)
	}
	var timer *time.Timer
	timer = time.AfterFunc(duration, func() {
		defer func() {
			t.mu.Lock()
			fmt.Println("log_str", log_str)
			delete(t.timers, name)
			t.mu.Unlock()
		}()
		fn()
	})
	fmt.Printf("name1-----------%s, duration=%v, log=%v timer=%p timers=%v\n", name, duration, log_str, timer, t.timers)
	t.mu.Lock()
	t.timers[name] = timer
	t.mu.Unlock()
}

func (t *TimeoutManager) StopAll() {
	t.mu.Lock()
	defer t.mu.Unlock()

	for _, timer := range t.timers {
		timer.Stop()
	}
	t.timers = make(map[string]*time.Timer)
}

func (t *TimeoutManager) StopByName(name string) bool {
	t.mu.Lock()
	defer t.mu.Unlock()
	if timer, exists := t.timers[name]; exists {
		b := timer.Stop()
		delete(t.timers, name)
		return b
	}
	return false
}
